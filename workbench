#!/bin/sh
# Starts the Steadforce k8s workbench with kind, kubectl, helm, yq and git.
# Only Docker is needed on your machine.
#
#   ./workbench            interactive shell
#   ./workbench <command>  run a single command
#
# The repository is mounted at /workspace. Port 8080 is published for the Argo CD UI.
# When the workshop cluster exists, the container joins its Docker network and
# kubectl is configured to reach it.

set -e

IMAGE=ghcr.io/steadforce/steadops/workbenches/k8s:sha-9d99d07
DIR="$(cd "$(dirname "$0")" >/dev/null 2>&1; pwd -P)"

INIT='
if kind get clusters 2>/dev/null | grep -qx hydration-workshop; then
  docker network connect kind "$HOSTNAME" 2>/dev/null || true
  kind export kubeconfig --internal --name hydration-workshop >/dev/null 2>&1
fi
'

if [ "$#" -eq 0 ]; then
  TTY="-it"
  CMD="$INIT exec bash"
else
  TTY=""
  [ -t 0 ] && TTY="-it"
  CMD="$INIT $*"
fi

# Only the first workbench publishes the Argo CD port, so a second terminal still starts.
PORT=""
[ -z "$(docker ps -q --filter publish=8080)" ] && PORT="-p 8080:8080"

exec docker run --rm $TTY $PORT \
  -v /var/run/docker.sock:/var/run/docker.sock \
  -v "$DIR":/workspace \
  -w /workspace \
  "$IMAGE" \
  bash -c "$CMD"
